{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "configs/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint apps packages configs",
    "lint:fix": "oxlint apps packages configs --fix",
    "ui:add": "bun run --cwd packages/ui shadcn:add"
  },
  "devDependencies": {
    "lerna": "^9.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
